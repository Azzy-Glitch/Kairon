# Kairon AI service configuration.
# Copy to .env and fill in. NEVER commit a real key.

# Provider selection is configuration-driven; no code change is required to switch.
#   qwen | gemini | groq | mock
AI__Provider=qwen

# Optional. Defaults per provider: qwen-plus / gemini-2.5-flash-lite / openai/gpt-oss-120b
AI__Model=

# Optional endpoint override (proxy or pinned deployment).
AI__Endpoint=

AI__TimeoutSeconds=30
AI__MaxRetries=2
AI__Temperature=0.2
AI__MaxOutputTokens=2048
AI__MaxResponseBytes=65536

# Required for every AI endpoint except /health. Use one strong random value shared only with the
# KAIRON backend; the packaged desktop generates this per launch and does not persist it.
KAIRON_AI_API_KEY=
KAIRON_AI_MAX_REQUEST_BYTES=65536
KAIRON_AI_REQUESTS_PER_MINUTE=12
KAIRON_AI_REQUESTS_PER_HOUR=120

# Force deterministic mock responses regardless of credentials.
AI__MockMode=false

# Credentials. Server-side only. If the key for the selected provider is missing or a
# placeholder, the service serves deterministic mock responses instead of failing.
QWEN_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

LOG_LEVEL=INFO
