<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Windows-only in truth (Scheduled Task component, session/process Win32 APIs,
         WindowsIdentity) - net10.0-windows makes that explicit rather than relying on plain
         net10.0 plus scattered CA1416 suppressions. Mirrors desktop/Kairon.Desktop.csproj, the
         other Windows-only project in this solution. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WinExe (Windows GUI subsystem), not Exe: this runs unattended in the interactive user's
         session via a logon-triggered Scheduled Task, so it must never allocate a console window. -->
    <OutputType>WinExe</OutputType>
    <UserSecretsId>kairon-useragent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

</Project>
