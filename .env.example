# KAIRON deployment configuration template.
#
# Copy to .env and fill in real values. NEVER commit a real .env - the .gitignore rules
# above this file's exemption already block .env, .env.*, and *.env for exactly that reason.
#
# This file covers the containerised deployment (docker-compose.cloud.yml), which Compose
# reads a sibling .env for automatically. The AI service also has its own standalone
# template for running it directly: see ai-service/.env.example.
#
# The packaged Windows desktop product needs none of this. It generates its own per-launch
# secrets, defaults to a local SQLite database, and stores a user-supplied AI provider key
# encrypted under the product's own data directory.


# --- Required. docker-compose.cloud.yml refuses to start if any of these is unset. ---

# SQL Server connection string for the backend. The containerised deployment uses SQL Server
# rather than SQLite, so this must point at a database that already exists.
KAIRON_SQL_CONNECTION=Server=sqlserver.example.com;Database=Kairon;User Id=kairon;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

# Operator key gating every security-relevant API action (project and credential management,
# remediation approval, AI configuration). Generate one strong random value and treat it as a
# password - anyone holding it can approve remediation.
#   openssl rand -base64 48
KAIRON_OPERATOR_KEY=

# Enrollment key an Agent installation presents to register its machine
# (POST /api/agent/register, header X-Kairon-Enrollment-Key). Generate a third, different random
# value: it authorizes introducing a machine and nothing else, and must NOT be the operator key -
# an Agent must never hold the credential that approves and executes remediation. Required here
# because no Agent reaches a containerised backend over loopback, so without it nothing can enroll.
#   openssl rand -base64 48
KAIRON_AGENT_ENROLLMENT_KEY=

# Shared secret the backend presents to the AI service on every call except /health. Generate a
# second, different random value; it is not interchangeable with the operator key.
#   openssl rand -base64 48
KAIRON_AI_SERVICE_KEY=

# Exact browser origin allowed to call the API (scheme + host + port, no trailing slash).
KAIRON_ALLOWED_ORIGIN=https://kairon.example.com

# Public HTTPS base address SDKs are told to send telemetry to when they pair. This is what an SDK
# persists and uses for the life of the installation, so it must be reachable from wherever the
# monitored applications actually run - not loopback, not a bind address, no embedded credentials,
# no query or fragment. The backend refuses to start (and refuses to redeem a pairing code) if this
# is missing or unusable while Product__RequirePublicBackendUrl is on.
KAIRON_PUBLIC_BACKEND_URL=https://kairon.example.com


# --- Required when running the TLS overlay (docker-compose.cloud.tls.yml). ---
#
# Caddy terminates TLS and is also where a HUMAN logs in. The backend has no login of its own: its
# only human credential is the operator key, which is a server secret and must never be typed into
# or stored by a browser. Caddy closes that gap - it strips any inbound X-Kairon-Operator-Key (so
# holding the key is not a way around the login), authenticates the person, and only then adds the
# operator key on the way upstream. SDK and Agent routes are untouched: they carry their own
# credentials and are never given the operator key.

# Public hostname. DNS must already point here and 80/443 must be reachable for Let's Encrypt.
KAIRON_PUBLIC_DOMAIN=kairon.example.com

# Dashboard login. The password is stored ONLY as a bcrypt hash, never in plaintext - generate one:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-dashboard-password'
KAIRON_DASHBOARD_USER=
KAIRON_DASHBOARD_PASSWORD_HASH=


# --- Optional. Defaults shown are what docker-compose.cloud.yml falls back to. ---

# Container image tag to build/run.
KAIRON_VERSION=dev

# Host port published for the backend (which also serves the built frontend).
KAIRON_HTTP_PORT=8000

# AI provider: groq | qwen | gemini | mock. Required - docker-compose.cloud.yml has no default,
# so a forgotten value fails "docker compose up" closed rather than silently starting on mock AI.
# Set "mock" only for a deliberate non-production/test deployment: it serves deterministic canned
# responses and needs no credentials.
KAIRON_AI_PROVIDER=

# Optional model override. Per-provider defaults apply when blank:
#   groq -> openai/gpt-oss-120b, qwen -> qwen-plus, gemini -> gemini-2.5-flash-lite
KAIRON_AI_MODEL=

# Force deterministic mock responses regardless of provider credentials. Only for deliberate
# test/development use - never a production setting.
KAIRON_AI_MOCK_MODE=false


# --- Provider credentials. Server-side only, never sent to a browser. ---
# Only the selected KAIRON_AI_PROVIDER's key is used. A missing or placeholder key for that
# provider makes the service report it as unconfigured and fail requests clearly - it never
# silently substitutes mock responses for a real provider that lacks a usable key.

GROQ_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=


# --- Optional: Windows installer code signing (installer/build-installer.ps1). ---
# Unset means the installer is built unsigned, and the build logs that plainly.
# Use EITHER a certificate already installed in a local certificate store...
KAIRON_SIGN_THUMBPRINT=
# ...OR a PFX file on disk.
KAIRON_SIGN_PFX_PATH=
KAIRON_SIGN_PFX_PASSWORD=


# --- Optional: test-only override. ---
# Points the SQL Server integration tests at a real instance. Each test creates and drops its
# own uniquely-named database and never touches the one named here. Unset, those tests fall
# back to (localdb)\MSSQLLocalDB and skip when no LocalDB is present.
KAIRON_TEST_SQLSERVER=
