# KAIRON deployment configuration template.
#
# Copy to .env and fill in real values. NEVER commit a real .env - the .gitignore rules
# above this file's exemption already block .env, .env.*, and *.env for exactly that reason.
#
# This file covers the containerised deployment (docker-compose.cloud.yml), which Compose
# reads a sibling .env for automatically. The AI service also has its own standalone
# template for running it directly: see ai-service/.env.example.
#
# The packaged Windows desktop product needs none of this. It generates its own per-launch
# secrets, defaults to a local SQLite database, and stores a user-supplied AI provider key
# encrypted under the product's own data directory.


# --- Required. docker-compose.cloud.yml refuses to start if any of these is unset. ---

# SQL Server connection string for the backend. The containerised deployment uses SQL Server
# rather than SQLite, so this must point at a database that already exists.
KAIRON_SQL_CONNECTION=Server=sqlserver.example.com;Database=Kairon;User Id=kairon;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

# Operator key gating every security-relevant API action (project and credential management,
# remediation approval, AI configuration). Generate one strong random value and treat it as a
# password - anyone holding it can approve remediation.
#   openssl rand -base64 48
KAIRON_OPERATOR_KEY=

# Shared secret the backend presents to the AI service on every call except /health. Generate a
# second, different random value; it is not interchangeable with the operator key.
#   openssl rand -base64 48
KAIRON_AI_SERVICE_KEY=

# Exact browser origin allowed to call the API (scheme + host + port, no trailing slash).
KAIRON_ALLOWED_ORIGIN=https://kairon.example.com


# --- Optional. Defaults shown are what docker-compose.cloud.yml falls back to. ---

# Container image tag to build/run.
KAIRON_VERSION=dev

# Host port published for the backend (which also serves the built frontend).
KAIRON_HTTP_PORT=8000

# AI provider: mock | groq | qwen | gemini. "mock" serves deterministic canned responses and
# needs no credentials, so a deployment is safe to bring up before any real key exists.
KAIRON_AI_PROVIDER=mock

# Optional model override. Per-provider defaults apply when blank:
#   groq -> openai/gpt-oss-120b, qwen -> qwen-plus, gemini -> gemini-2.5-flash-lite
KAIRON_AI_MODEL=

# Force deterministic mock responses regardless of provider credentials.
KAIRON_AI_MOCK_MODE=false


# --- Provider credentials. Server-side only, never sent to a browser. ---
# Only the selected KAIRON_AI_PROVIDER's key is used. A missing or placeholder key makes the AI
# service fall back to mock responses rather than failing outright.

GROQ_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=


# --- Optional: Windows installer code signing (installer/build-installer.ps1). ---
# Unset means the installer is built unsigned, and the build logs that plainly.
# Use EITHER a certificate already installed in a local certificate store...
KAIRON_SIGN_THUMBPRINT=
# ...OR a PFX file on disk.
KAIRON_SIGN_PFX_PATH=
KAIRON_SIGN_PFX_PASSWORD=


# --- Optional: test-only override. ---
# Points the SQL Server integration tests at a real instance. Each test creates and drops its
# own uniquely-named database and never touches the one named here. Unset, those tests fall
# back to (localdb)\MSSQLLocalDB and skip when no LocalDB is present.
KAIRON_TEST_SQLSERVER=
