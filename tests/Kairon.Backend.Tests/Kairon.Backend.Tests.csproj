<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- SQLite rather than the EF in-memory provider: the SRE model relies on unique indexes,
         cascade deletes and string-converted enums, and a provider that ignores those would let a
         broken model configuration pass its own tests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- Real in-process HTTP pipeline testing (PairingRateLimitTests): the ASP.NET Core rate
         limiter only engages through the actual request pipeline (UseRateLimiter() + the
         [EnableRateLimiting] attribute's routing metadata) - a unit-level call straight into a
         controller action, as the rest of this project does, cannot exercise it at all. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\Kairon.Backend.csproj" />
  </ItemGroup>

</Project>
